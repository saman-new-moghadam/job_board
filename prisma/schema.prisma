generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id           Int           @id @default(autoincrement())
  firstName    String
  lastName     String
  email        String        @unique
  password     String
  role         Role
  sessions     Session[]
  jobs Job[]
  applications Application[]
  createdAt DateTime @default(now())
}

enum Role {
  JOB_SEEKER
  EMPLOYER
}

model Session {
  sessionId String @id
  userId Int 
  user User @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Job {
  id Int @id @default(autoincrement())
  title String 
  description String
  location String
  minSalary Int
  maxSalary Int
  status JobStatus @default(OPEN)
  employerId Int 
  employer User @relation(fields: [employerId], references: [id])
  applications Application[]
  createdAt DateTime @default(now())
}

enum JobStatus {
  OPEN
  CLOSED
}

model Application {
  id Int @id @default(autoincrement())
  userId Int 
  jobId Int 
  coverLetter String
  resume String
  status ApplicationStatus @default(PENDING)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id]) 
  job Job @relation(fields: [jobId], references: [id])
  

  @@unique([jobId, userId])
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  ACCEPTED
  REJECTED
}
